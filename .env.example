# Copy to .env.local for local development. On Vercel, add these under
# Project > Settings > Environment Variables.

# Supabase > Project Settings > API Keys (or "API")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The public key: "Publishable key" (sb_publishable_...) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY secret key: "Secret key" (sb_secret_...) or the legacy "service_role" key.
# Used only by the contact form route. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Your public website address (no trailing slash), e.g. https://fakhrullah.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Any long random string; used to anonymise visitor IPs for spam rate limiting
CONTACT_HASH_SALT=change-me-to-a-long-random-string

# Optional: email notification for new contact messages (https://resend.com)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=

# Optional: Cloudflare Turnstile anti-bot check on the contact form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
